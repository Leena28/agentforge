# Database
DATABASE_URL=postgresql+asyncpg://yuno:yuno@postgres:5432/yuno_agentops

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LLM
LLM_MODEL=gpt-4o-mini
ENABLE_LLM=true
OPENAI_API_KEY=your-openai-api-key-here

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_TEMPLATE=yuno-chargeback-management

# App
APP_NAME=AgentForge
APP_ENV=local
SEED_DEMO_DATA=true
RUN_WORKFLOWS_INLINE=false

# Memory
PGVECTOR_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000